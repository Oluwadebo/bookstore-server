# Copy this file to ".env" and fill in real values. Never commit ".env".

NODE_ENV=development
PORT=5000

# MongoDB connection string (local, or a MongoDB Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore

# Origin of the React app, used for CORS. No trailing slash.
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens. Use a long random string (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Added in step 4 (payments and downloads) ---
# Payment gateway. Only "paystack" is built in (see src/payments/ to add others).
PAYMENT_PROVIDER=paystack
# Paystack Dashboard > Settings > API Keys & Webhooks. Use the TEST secret key (sk_test_...)
# while developing and the LIVE key (sk_live_...) only on the live server.
PAYSTACK_SECRET_KEY=
# Currency for new books, e.g. NGN or USD. Prices are stored in the smallest unit (kobo/cents).
STORE_CURRENCY=USD
# Private folder for book files (relative to the server folder). Never make it public.
STORAGE_DIR=storage/books

# --- Added in step 2 (authentication) ---
# Cookie SameSite policy: lax (default), strict, or none.
# Keep "lax" when the site and API share a domain, e.g. yourstore.com + api.yourstore.com.
COOKIE_SAMESITE=lax

# --- Optional: only if your network blocks MongoDB Atlas (mongodb+srv) DNS lookups ---
# DNS_SERVERS=8.8.8.8,1.1.1.1
