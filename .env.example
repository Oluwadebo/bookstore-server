# Copy this file to ".env" and fill in real values. Never commit ".env".

NODE_ENV=development
PORT=5000

# MongoDB connection string (local, or a MongoDB Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore

# Origin of the React app, used for CORS. No trailing slash.
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens. Use a long random string (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Added in step 4 (payments and downloads) ---
# Payment gateway. Only "paystack" is built in (see src/payments/ to add others).
PAYMENT_PROVIDER=paystack
# Paystack Dashboard > Settings > API Keys & Webhooks. Use the TEST secret key (sk_test_...)
# while developing and the LIVE key (sk_live_...) only on the live server.
PAYSTACK_SECRET_KEY=
# Currency for new books, e.g. NGN or USD. Prices are stored in the smallest unit (kobo/cents).
STORE_CURRENCY=NGN
# Private folder for book files (relative to the server folder). Never make it public.
STORAGE_DIR=storage/books

# --- Added in step 5 (admin uploads) ---
# Public cover images (served at /api/covers) and a temporary folder for uploads being checked.
COVERS_DIR=storage/covers
TMP_DIR=storage/tmp
# Largest book file the admin can upload, in megabytes (max 500).
MAX_BOOK_FILE_MB=50

# --- Added in step 2 (authentication) ---
# Cookie SameSite policy: lax (default), strict, or none.
# Keep "lax" when the site and API share a domain, e.g. yourstore.com + api.yourstore.com.
COOKIE_SAMESITE=lax

# --- Added in step 5 (sellers, commission, password reset) ---
# The store's cut of each seller's LIST price, in percent. Can be changed later in Admin > Earnings.
COMMISSION_PERCENT=10
# Add Paystack's fee on top of the list price so the customer covers it (Naira only).
# Defaults match Paystack's local card pricing; change them if Paystack's rates change.
PASS_FEES_TO_CUSTOMER=true
FEE_PERCENT=1.5
FEE_FIXED=100
FEE_FIXED_WAIVED_BELOW=2500
FEE_CAP=2000
# Statement months follow this clock (Nigeria = 1).
STORE_UTC_OFFSET_HOURS=1
# Email for password resets. Leave SMTP_HOST empty in development: the link prints in this console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Store <no-reply@yourstore.com>"

# --- Optional: only if your network blocks MongoDB Atlas (mongodb+srv) DNS lookups ---
# DNS_SERVERS=8.8.8.8,1.1.1.1
